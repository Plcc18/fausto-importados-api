# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/fausto_importados_db
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# JWT (gerar com: openssl rand -base64 32)
JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRATION=86400000

# Cloudinary
CLOUDINARY_NAME=seu_cloud_name
CLOUDINARY_KEY=sua_api_key
CLOUDINARY_SECRET=sua_api_secret

# Admin inicial
ADMIN_EMAIL=admin@fausto.com
ADMIN_PASSWORD=sua_senha_de_admin

# Porta (opcional)
PORT=8080
