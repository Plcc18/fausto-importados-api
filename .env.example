# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/fausto_importados_db
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# JWT (gerar com: openssl rand -base64 32)
JWT_SECRET=troque_por_um_segredo_forte
# Prazos (ISO-8601, todos opcionais — estes são os padrões)
# JWT_ACCESS_TTL=PT15M        vida do access token
# REFRESH_INACTIVITY=P7D      sessão expira após 7 dias sem refresh (renova a cada uso)
# REFRESH_ABSOLUTE=P30D       limite absoluto da sessão (não renova)
# REFRESH_GRACE=PT10S         tolerância para refresh concorrente (várias abas)

# Origem(ns) do front, separadas por vírgula (CORS e verificação de Origin no refresh)
FRONTEND_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_NAME=seu_cloud_name
CLOUDINARY_KEY=sua_api_key
CLOUDINARY_SECRET=sua_api_secret

# Admin inicial
ADMIN_EMAIL=admin@fausto.com
ADMIN_PASSWORD=sua_senha_de_admin

# Porta (opcional)
PORT=8080
