# Copie este arquivo para application.yml (ou defina as variáveis de ambiente
# abaixo diretamente no seu ambiente/IDE) para rodar o projeto localmente.
# Nenhum valor real de segredo deve ser commitado — em application.yml e nos
# demais application-*.yml a aplicação só lê nomes de variáveis de ambiente
# (${VAR}), nunca segredos literais.
#
# Variáveis de ambiente necessárias:
#   DB_URL              - ex: jdbc:postgresql://localhost:5432/fausto_importados_db
#   DB_USERNAME
#   DB_PASSWORD
#   JWT_SECRET           - chave em Base64 com pelo menos 256 bits (ex: openssl rand -base64 32)
#   JWT_ACCESS_TTL        - opcional, vida do access token (default: PT15M). JWT_EXPIRATION não é mais usado.
#   REFRESH_INACTIVITY    - opcional, expiração por inatividade do refresh token (default: P7D)
#   REFRESH_ABSOLUTE      - opcional, limite absoluto da sessão (default: P30D)
#   REFRESH_GRACE         - opcional, tolerância a refresh concorrente (default: PT10S)
#   FRONTEND_URL          - origem(ns) do front, separadas por vírgula (CORS + verificação de Origin no refresh)
#   CLOUDINARY_NAME
#   CLOUDINARY_KEY
#   CLOUDINARY_SECRET
#   TOTP_ENCRYPTION_KEY   - chave AES-256 em base64 (openssl rand -base64 32) que cifra os segredos do 2FA. OBRIGATÓRIA
#   ADMIN_EMAIL           - email do PRIMEIRO admin (criado só se ainda não houver nenhum)
#   ADMIN_PASSWORD        - senha do primeiro admin (o 2FA é cadastrado no primeiro login)
#   PORT                  - opcional (default: 8080)
#
# Perfis disponíveis (spring.profiles.active=dev|prod):
#   dev  - logs verbosos de segurança, cookies com secure=false/same-site=Strict (HTTP local)
#   prod - logs reduzidos, cookies com secure=true/same-site=Strict (HTTPS)

spring:
  application:
    name: fausto-importados-api

  datasource:
    url: "${DB_URL}"
    username: "${DB_USERNAME}"
    password: "${DB_PASSWORD}"

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration

server:
  port: "${PORT:8080}"

logging:
  level:
    org.springframework.security: DEBUG

security:
  jwt:
    secret: "${JWT_SECRET}"
  totp:
    encryption-key: "${TOTP_ENCRYPTION_KEY:}"
  auth:
    access-ttl: "${JWT_ACCESS_TTL:PT15M}"
    refresh-inactivity: "${REFRESH_INACTIVITY:P7D}"
    refresh-absolute: "${REFRESH_ABSOLUTE:P30D}"
    refresh-grace: "${REFRESH_GRACE:PT10S}"

cloudinary:
  cloud_name: "${CLOUDINARY_NAME}"
  api_key: "${CLOUDINARY_KEY}"
  api_secret: "${CLOUDINARY_SECRET}"

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html

ADMIN_EMAIL: "${ADMIN_EMAIL:}"
ADMIN_PASSWORD: "${ADMIN_PASSWORD:}"

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      show-details: never
